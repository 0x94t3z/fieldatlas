{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answer": { "type": "string" },
          "questionId": { "minLength": 1, "type": "string" }
        },
        "required": ["questionId", "answer"],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": { "const": 1 }
  },
  "required": ["schemaVersion", "results"],
  "type": "object"
}
