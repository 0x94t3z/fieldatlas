<resources>
    <style name="Theme.FieldAtlas" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#111A15</item>
        <item name="android:navigationBarColor">#16231C</item>
        <!-- Launch splash on the theme's forest green instead of the platform white. -->
        <item name="android:windowSplashScreenBackground">#285D49</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#285D49</item>
        <!-- Paper behind the first frame, so no white flash follows the splash. -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorAccent">#A6D8B9</item>
    </style>
</resources>
