<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch animation: the 3D coin turns once and settles face-on (about 0.75 s, close to a cold
  start on a low-end phone). Each frame is inset to the centre two thirds, the circle the system
  splash shows, so the frames carry no pixels the mask would discard.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="true">
    <item android:duration="30">
        <inset android:drawable="@drawable/splash_coin_00" android:inset="16.667%" />
    </item>
