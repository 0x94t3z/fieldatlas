+// ---------------------------------------------------------------------------
+// Field Atlas: embedding encoder for vector-capable knowledge packs.
+//
+// The encoder (e.g. BAAI/bge-small-en-v1.5 GGUF shipped inside the pack) is a second,
+// tiny model with its own globals — independent of the chat model above, so Library
+// changes can swap the encoder while an answer model stays loaded. Mirrors the verified
+// offline pipeline: single sequence, logits on the last token, pooled sequence embedding
+// (CLS pooling from the GGUF), L2-normalized output. See tools/build_vector_pack.py for
+// the corpus side of the same recipe.
+// ---------------------------------------------------------------------------
+
+static llama_model                     * g_encoder_model   = nullptr;
+static llama_context                   * g_encoder_context = nullptr;
+
+extern "C"
+JNIEXPORT jboolean JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_loadEncoderNative(
+        JNIEnv * env, jobject /*unused*/, jstring jpath) {
+    const char * path = env->GetStringUTFChars(jpath, nullptr);
+    std::string model_path(path);
+    env->ReleaseStringUTFChars(jpath, path);
+    if (g_encoder_context) {
+        llama_free(g_encoder_context);
+        g_encoder_context = nullptr;
+    }
+    if (g_encoder_model) {
+        llama_model_free(g_encoder_model);
+        g_encoder_model = nullptr;
+    }
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = 0;
+    g_encoder_model = llama_model_load_from_file(model_path.c_str(), mparams);
+    if (!g_encoder_model) {
+        LOG_ERR("%s: failed to load encoder %s\n", __func__, model_path.c_str());
+        return JNI_FALSE;
+    }
+    const int train_ctx = llama_model_n_ctx_train(g_encoder_model);
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx         = (uint32_t) std::max(64, train_ctx);
+    cparams.n_batch       = (uint32_t) std::max(64, train_ctx);
+    cparams.n_ubatch      = (uint32_t) std::max(64, train_ctx);
+    cparams.n_seq_max     = 1;
+    cparams.embeddings    = true;   // pooled sequence embeddings (honors the GGUF pooling type)
+    cparams.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    g_encoder_context = llama_init_from_model(g_encoder_model, cparams);
+    if (!g_encoder_context) {
+        LOG_ERR("%s: failed to create encoder context\n", __func__);
+        llama_model_free(g_encoder_model);
+        g_encoder_model = nullptr;
+        return JNI_FALSE;
+    }
+    LOG_INF("%s: encoder loaded (%s, dim=%d, train_ctx=%d)\n",
+            __func__, model_path.c_str(), llama_model_n_embd(g_encoder_model), train_ctx);
+    return JNI_TRUE;
+}
+
+extern "C"
+JNIEXPORT void JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_unloadEncoderNative(JNIEnv *, jobject /*unused*/) {
+    if (g_encoder_context) { llama_free(g_encoder_context);        g_encoder_context = nullptr; }
+    if (g_encoder_model)   { llama_model_free(g_encoder_model);    g_encoder_model   = nullptr; }
+}
+
+extern "C"
+JNIEXPORT jfloatArray JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_embedNative(JNIEnv * env, jobject, jstring jtext) {
+    if (!g_encoder_model || !g_encoder_context) return nullptr;
+    const llama_vocab * vocab  = llama_model_get_vocab(g_encoder_model);
+    const int           dim    = llama_model_n_embd(g_encoder_model);
+    const int           max_tokens = std::max(8, llama_model_n_ctx_train(g_encoder_model) - 4);
+
+    const char * text = env->GetStringUTFChars(jtext, nullptr);
+    std::string input(text);
+    env->ReleaseStringUTFChars(jtext, text);
+
+    std::vector<llama_token> tokens(dim + max_tokens + 8);
+    int n_tokens = llama_tokenize(vocab, input.c_str(), (int32_t) input.size(),
+                                  tokens.data(), (int32_t) tokens.size(),
+                                  /* add_bos = */ true, /* special = */ true);
+    if (n_tokens < 0) {
+        n_tokens = -n_tokens;
+        if (n_tokens > max_tokens) n_tokens = max_tokens;
+        n_tokens = llama_tokenize(vocab, input.c_str(), (int32_t) input.size(),
+                                  tokens.data(), n_tokens, true, true);
+    }
+    if (n_tokens <= 0 || n_tokens > max_tokens) {
+        n_tokens = std::min(n_tokens, max_tokens);
+        if (n_tokens <= 0) return nullptr;
+    }
+    tokens.resize(n_tokens);
+
+    llama_batch batch = llama_batch_init(n_tokens, 0, 1);
+    for (int i = 0; i < n_tokens; i++) {
+        common_batch_add(batch, tokens[i], (llama_pos) i, /* seq_id = */ {0},
+                         /* logits = */ i + 1 == n_tokens);
+    }
+    jfloatArray result = nullptr;
+    if (llama_encode(g_encoder_context, batch) == 0) {
+        const float * embedding = llama_get_embeddings_seq(g_encoder_context, 0);
+        if (embedding) {
+            float norm = 0.0f;
+            for (int j = 0; j < dim; j++) norm += embedding[j] * embedding[j];
+            norm = std::sqrt(norm);
+            std::vector<jfloat> normalized(dim);
+            for (int j = 0; j < dim; j++) {
+                normalized[j] = norm > 0.0f ? (jfloat) (embedding[j] / norm) : 0.0f;
+            }
+            result = env->NewFloatArray(dim);
+            if (result) env->SetFloatArrayRegion(result, 0, dim, normalized.data());
+        }
+    } else {
+        LOG_ERR("%s: encoder forward pass failed\n", __func__);
+    }
+    llama_batch_free(batch);
+    return result;
+}
